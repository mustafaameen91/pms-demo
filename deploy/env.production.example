# Copy to /var/www/pms.codility.tech/app/.env on the server and fill in the blanks.
# Generate secrets with:  openssl rand -base64 32

# Same password as POSTGRES_PASSWORD in db.env (URL-encode it if it has symbols; openssl rand -hex 24 avoids that)
DATABASE_URL=postgres://tamm:CHANGE_ME@127.0.0.1:5433/tamm

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://pms.codility.tech
NEXT_PUBLIC_APP_URL=https://pms.codility.tech

# Outside the app folder, so uploading a new version never touches people's files
UPLOAD_DIR=/var/www/pms.codility.tech/uploads

# Platform admins (comma-separated emails): can open /admin to activate workspaces
SUPER_ADMIN_EMAILS=
# Days a new workspace can be used before payment (0 = must pay first)
TRIAL_DAYS=0

# Weekly reports timer (see deploy/README.md). Leave empty to switch it off.
CRON_SECRET=

# Email (password resets, invitations). Without SMTP_HOST, emails are NOT sent: they are
# printed to the PM2 log instead (pm2 logs tamm).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=tamm <no-reply@codility.tech>
