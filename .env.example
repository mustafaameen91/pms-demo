DATABASE_URL=postgres://pms:pms@localhost:5433/pms
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
# where receipts are stored on disk (back this folder up!)
UPLOAD_DIR=./uploads
# Email (optional). Without SMTP_HOST, emails are printed to the server terminal instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="PMS <no-reply@example.com>"

# Platform admins (comma-separated emails) — can open /admin to activate workspaces
SUPER_ADMIN_EMAILS=
# Days a new workspace can be used before payment (0 = must pay first)
TRIAL_DAYS=0
